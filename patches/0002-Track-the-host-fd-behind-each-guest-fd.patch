+#ifdef HAVE_VIRTUAL_FDS
+// implements dup(), dup2(), dup3() and F_DUPFD when blink chooses the
+// guest fd numbers. the new guest fd is `newfildes` if it's not -1, in
+// which case whatever was there is closed, otherwise it's the lowest
+// free number at least `minfildes`. it wraps a host dup() of the fd.
+static int DupGuestFd(struct Machine *m, int fildes, int newfildes,
+                      int minfildes, int cloexec) {
+  int rc, lim, hostfd;
+  struct Fd *fd, *fd2, *old = 0;
+  lim = GetFileDescriptorLimit(m->system);  // mmap_lock comes before fds.lock
+  LOCK(&m->system->fds.lock);
+  if (!(fd = GetFd(&m->system->fds, fildes))) {
+    rc = -1;
+  } else if (newfildes == fildes) {
+    rc = fildes;
+  } else if ((hostfd = VfsDup(fd->hostfd)) == -1) {
+    rc = -1;
+  } else {
+    if (newfildes == -1) {
+      newfildes = GetFreeFildes(&m->system->fds, minfildes);
+    } else if ((old = GetFd(&m->system->fds, newfildes))) {
+      dll_remove(&m->system->fds.list, &old->elem);
+    }
+    if (newfildes >= lim) {
+      VfsClose(hostfd);
+      rc = emfile();
+    } else if (!(fd2 = ForkFd(&m->system->fds, fd, hostfd,
+                              (fd->oflags & ~O_CLOEXEC) | cloexec))) {
+      VfsClose(hostfd);
+      rc = -1;
+    } else {
+      fd2->cb = fd->cb;
+      fd2->fildes = rc = newfildes;
+    }
+  }
+  UNLOCK(&m->system->fds.lock);
+  if (old) {
+    old->cb->close(old->hostfd);
+    FreeFd(old);
+  }
+  return rc;
+}
+#endif
