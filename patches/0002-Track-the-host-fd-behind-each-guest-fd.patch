 }
 
+#ifdef HAVE_VIRTUAL_FDS
+// returns lowest guest fd number that's at least `minfildes` and free
+int GetFreeFildes(struct Fds *fds, int minfildes) {
+  int i, n;
+  bool *used;
+  struct Dll *e;
+  n = CountFds(fds) + 1;  // so the answer is below minfildes + n
+  unassert((used = (bool *)calloc(n, sizeof(*used))));
+  for (e = dll_first(fds->list); e; e = dll_next(fds->list, e)) {
+    i = FD_CONTAINER(e)->fildes - minfildes;
+    if (0 <= i && i < n) used[i] = true;
+  }
+  for (i = 0; used[i]; ++i) {
+  }
+  free(used);
+  return minfildes + i;
+}
+#endif
+
 struct Fd *AddFd(struct Fds *fds, int fildes, int oflags) {
   struct Fd *fd;
   if (fildes >= 0) {
     if ((fd = (struct Fd *)calloc(1, sizeof(*fd)))) {
       dll_init(&fd->elem);
       fd->cb = &kFdCbHost;
+#ifdef HAVE_VIRTUAL_FDS
+      fd->fildes = GetFreeFildes(fds, 0);
+#else
       fd->fildes = fildes;
+#endif
+      fd->hostfd = fildes;
       fd->oflags = oflags;
       unassert(!pthread_mutex_init(&fd->lock, 0));
       dll_make_first(&fds->list, &fd->elem);
@@ -144,17 +168,19 @@ void InheritFd(struct Fd *fd) {
 #ifndef DISABLE_SOCKETS
   socklen_t addrlen;
   if (!fd) return;
-  if (!GetFdSocketType(fd->fildes, &fd->socktype)) {
-    fd->norestart = IsNoRestartSocket(fd->fildes);
+  if (!GetFdSocketType(fd->hostfd, &fd->socktype)) {
+    fd->norestart = IsNoRestartSocket(fd->hostfd);
     addrlen = sizeof(fd->saddr);
-    VfsGetsockname(fd->fildes, (struct sockaddr *)&fd->saddr, &addrlen);
+    VfsGetsockname(fd->hostfd, (struct sockaddr *)&fd->saddr, &addrlen);
   }
 #endif
 }
 
 void AddStdFd(struct Fds *fds, int fildes) {
   int flags;
+  struct Fd *fd;
   if ((flags = VfsFcntl(fildes, F_GETFL, 0)) >= 0) {
-    InheritFd(AddFd(fds, fildes, flags));
+    if ((fd = AddFd(fds, fildes, flags))) fd->fildes = fildes;
+    InheritFd(fd);
   }
 }
