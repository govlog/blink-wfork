+│ PERFORMANCE OF THIS SOFTWARE.                                                │
+╚─────────────────────────────────────────────────────────────────────────────*/
+#include "blink/threadfork.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "blink/assert.h"
+#include "blink/endian.h"
+#include "blink/errno.h"
+#include "blink/fds.h"
+#include "blink/linux.h"
+#include "blink/log.h"
+#include "blink/machine.h"
+#include "blink/vfs.h"
+#include "blink/xlat.h"
+
+#ifdef HAVE_THREADED_FORK
+
+// Threaded fork() for hosts that can't fork(), e.g. WebAssembly
+//
+// The child process runs on a new thread, with its own System, whose
+// address space and file descriptors are copies of the parent's. This
+// file keeps the table of those children, so wait4() can reap them.
+//
+// Since all guest processes now share the host's file descriptors, it
+// implies HAVE_VIRTUAL_FDS. It also needs non-linear memory, to let a
+// guest address map to different host memory in each process.
+//
+// TODO: Stop the other threads of a child process when it exits.
+
+struct Child {
+  struct Child *next;
+  int pid;
+  int ppid;
+  int wstatus;
+  bool zombie;
+  pthread_t thread;
+  struct Machine *m;  // set on exit, then freed by the reaper
+};
+
+static struct Children {
+  pthread_mutex_t_ lock;
+  pthread_cond_t_ cond;
+  struct Child *list;
+  int lastpid;
+} g_children = {
+    PTHREAD_MUTEX_INITIALIZER_,
+    PTHREAD_COND_INITIALIZER,
+};
+
+static struct Child *FindChild(int pid) {
+  struct Child *c;
+  for (c = g_children.list; c; c = c->next) {
+    if (c->pid == pid) break;
+  }
+  return c;
+}
+
+// registers child system `s` of process `ppid` and assigns its pid
+int AddChildProcess(struct System *s, int ppid) {
+  struct Child *c;
+  if (!(c = (struct Child *)calloc(1, sizeof(*c)))) return enomem();
+  LOCK(&g_children.lock);
+  if (!g_children.lastpid) g_children.lastpid = getpid();
+  c->pid = s->pid = ++g_children.lastpid;
+  c->ppid = ppid;
+  c->next = g_children.list;
+  g_children.list = c;
+  UNLOCK(&g_children.lock);
+  return c->pid;
+}
+
+void RemoveChildProcess(int pid) {
+  struct Child **p, *c;
+  LOCK(&g_children.lock);
+  for (p = &g_children.list; (c = *p); p = &c->next) {
+    if (c->pid == pid) {
+      *p = c->next;
+      free(c);
+      break;
+    }
+  }
+  UNLOCK(&g_children.lock);
+}
+
+void SetChildThread(int pid, pthread_t thread) {
+  struct Child *c;
+  LOCK(&g_children.lock);
+  if ((c = FindChild(pid))) c->thread = thread;
+  UNLOCK(&g_children.lock);
+}
+
+// ends the child process `m` belongs to with `wstatus` for wait4(). the
+// fds are closed now, so pipe readers see eof, but memory is freed by
+// the reaper, once this thread is gone.
+_Noreturn void ExitChildProcess(struct Machine *m, int wstatus) {
+  struct Fd *fd;
+  struct Dll *e;
+  struct Child *c;
+  LOCK(&m->system->fds.lock);
+  while ((e = dll_first(m->system->fds.list))) {
+    dll_remove(&m->system->fds.list, e);
+    fd = FD_CONTAINER(e);
+    if (fd->dirstream) {
+      VfsClosedir(fd->dirstream);
+    } else {
+      fd->cb->close(fd->hostfd);
+    }
+    FreeFd(fd);
+  }
+  UNLOCK(&m->system->fds.lock);
+  LOCK(&g_children.lock);
+  if ((c = FindChild(m->system->pid))) {
+    c->m = m;
+    c->wstatus = wstatus;
+    c->zombie = true;
+  }
+  unassert(!pthread_cond_broadcast(&g_children.cond));
+  UNLOCK(&g_children.lock);
+  pthread_exit(0);
+}
+
+int WaitChildProcess(struct Machine *m, int pid, i64 wstatusaddr, int options,
+                     i64 rusageaddr) {
+  int rc;
+  bool any;
+  u8 gwstatus[4];
+  struct Child **p, *c;
+  struct rusage_linux gru;
+  if ((options = XlatWait(options)) == -1) return -1;
+  if ((wstatusaddr &&
+       !IsValidMemory(m, wstatusaddr, sizeof(gwstatus), PROT_WRITE)) ||
+      (rusageaddr && !IsValidMemory(m, rusageaddr, sizeof(gru), PROT_WRITE))) {
+    return -1;
+  }
+  LOCK(&g_children.lock);
+  for (;;) {
+    any = false;
+    for (p = &g_children.list; (c = *p); p = &c->next) {
+      if (c->ppid != m->system->pid) continue;
+      if (pid > 0 && c->pid != pid) continue;
+      any = true;
+      if (c->zombie) {
+        *p = c->next;
+        break;
+      }
+    }
+    if (c || !any || (options & WNOHANG)) break;
+    pthread_cond_wait(&g_children.cond, &g_children.lock);
+  }
+  UNLOCK(&g_children.lock);
+  if (!c) return any ? 0 : echild();
+  // the thread may still be unwinding after it marked itself a zombie
+  unassert(!pthread_join(c->thread, 0));
+  FreeMachine(c->m);
+  if (wstatusaddr) {
+    Write32(gwstatus, c->wstatus);
+    CopyToUserWrite(m, wstatusaddr, gwstatus, sizeof(gwstatus));
+  }
+  if (rusageaddr) {
+    memset(&gru, 0, sizeof(gru));
+    CopyToUserWrite(m, rusageaddr, &gru, sizeof(gru));
+  }
+  rc = c->pid;
+  free(c);
+  return rc;
+}
+
+#endif /* HAVE_THREADED_FORK */
