+#ifdef HAVE_THREADED_FORK
+// copies page table `pt` of src into dst, returning dst's entry for it.
+// pages are copied, so the two processes never share host memory. that
+// includes pages of file mappings, which means MAP_SHARED isn't shared
+// across fork(). reserved anonymous pages stay reserved.
+static u64 CopyPageTable(struct System *dst, struct System *src, u64 pt,
+                         long level) {
+  long i;
+  u8 *mi, *mo;
+  u64 pte, res, page, perm;
+  if ((res = AllocatePageTable(dst)) == -1) return -1;
+  mi = GetPageAddress(src, pt, level == 1);
+  mo = GetPageAddress(dst, res, level == 1);
+  ClearPage(mo);
+  for (i = 0; i < 512; ++i) {
+    if (!(pte = LoadPte(mi + i * 8))) continue;
+    if (level < 4) {
+      if ((page = CopyPageTable(dst, src, pte, level + 1)) == -1) return -1;
+      StorePte(mo + i * 8,
+               (page & (PAGE_TA | PAGE_HOST)) | (pte & ~(PAGE_TA | PAGE_HOST)));
+      continue;
+    }
+    perm = pte & (PAGE_RW | PAGE_U | PAGE_XD | PAGE_GROW);
+    if ((pte & PAGE_HOST) && (!(pte & PAGE_RSRV) || (pte & PAGE_MUG))) {
+      if ((page = AllocateAnonymousPage(dst)) == -1) return -1;
+      memcpy(FindHostPage(page), FindHostPage(pte), 4096);
+      dst->memstat.committed += 1;
+      StorePte(mo + i * 8, (page & (PAGE_TA | PAGE_HOST)) | PAGE_V | perm);
+    } else if (pte & PAGE_RSRV) {
+      dst->memstat.reserved += 1;
+      StorePte(mo + i * 8, PAGE_RSRV | PAGE_V | perm);
+    }
+  }
+  return res;
+}
+
+// gives the child of a threaded fork() a copy of the parent's memory
+int CopyAddressSpace(struct System *dst, struct System *src) {
+  u64 cr3;
+  unassert(!HasLinearMapping());
+  LOCK(&src->mmap_lock);
+  cr3 = CopyPageTable(dst, src, src->cr3, 1);
+  UNLOCK(&src->mmap_lock);
+  if (cr3 == -1) return -1;
+  dst->cr3 =
+      (cr3 & (PAGE_TA | PAGE_HOST)) | (src->cr3 & ~(PAGE_TA | PAGE_HOST));
+  dst->cr0 = src->cr0;
+  dst->cr2 = src->cr2;
+  dst->cr4 = src->cr4;
+  dst->efer = src->efer;
+  dst->gdt_base = src->gdt_base;
+  dst->gdt_limit = src->gdt_limit;
+  dst->idt_base = src->idt_base;
+  dst->idt_limit = src->idt_limit;
+  dst->brk = src->brk;
+  dst->brkchanged = src->brkchanged;
+  dst->automap = src->automap;
+  dst->codestart = src->codestart;
+  dst->codesize = src->codesize;
+  dst->loaded = src->loaded;
+  dst->iscosmo = src->iscosmo;
+  return 0;
+}
+#endif
+
 u64 AllocateAnonymousPage(struct System *s) {
   u8 *page;
   size_t i, n;
@@ -659,7 +724,12 @@ static bool FreePage(struct System *s, i64 virt, u64 entry, u64 size,
     pagesize = FLAG_pagesize;
     real = mug = FindHostPage(entry);
     while ((uintptr_t)mug & (pagesize - 1)) mug -= 4096;
+#ifdef __EMSCRIPTEN__
+    // emscripten can't unmap part of a file mapping, so the memory leaks
+    Munmap(mug, real - mug + size);
+#else
     unassert(!Munmap(mug, real - mug + size));
+#endif
     if (entry & PAGE_RSRV) {
       s->memstat.reserved -= 1;
     } else {
