+#ifdef HAVE_THREADED_FORK
+// gives the child its own host dup() of each of the parent's fds
+static int CopyFds(struct Fds *dst, struct Fds *src) {
+  int rc, hostfd;
+  struct Dll *e;
+  struct Fd *fd, *fd2;
+  LOCK(&src->lock);
+  for (rc = 0, e = dll_first(src->list); e; e = dll_next(src->list, e)) {
+    fd = FD_CONTAINER(e);
+    if ((hostfd = VfsDup(fd->hostfd)) == -1) {
+      rc = -1;
+      break;
+    }
+    if (!(fd2 = ForkFd(dst, fd, hostfd, fd->oflags))) {
+      VfsClose(hostfd);
+      rc = -1;
+      break;
+    }
+    fd2->cb = fd->cb;
+    fd2->fildes = fd->fildes;
+  }
+  UNLOCK(&src->lock);
+  return rc;
+}
+
+// implements fork() by running the child on a new thread (threadfork.c)
+static int ThreadFork(struct Machine *m, u64 flags, u64 stack, u64 ctid) {
+  int pid, err;
+  pthread_t thread;
+  struct System *s;
+  sigset_t ss, oldss;
+  struct Machine *m2;
+  _Atomic(int) *ctid_ptr;
+  if (!(s = NewSystem(m->system->mode))) return eagain();
+  s->isfork = true;
+  s->exec = m->system->exec;
+  s->onfilemap = m->system->onfilemap;
+  s->blinksigs = m->system->blinksigs;
+  memcpy(s->hands, m->system->hands, sizeof(s->hands));
+  memcpy(s->rlim, m->system->rlim, sizeof(s->rlim));
+  if (CopyAddressSpace(s, m->system) == -1 ||
+      CopyFds(&s->fds, &m->system->fds) == -1) {
+    FreeSystem(s);
+    return enomem();
+  }
+  m->threaded = true;
+  if (!(m2 = NewMachine(s, m))) {
+    FreeSystem(s);
+    return eagain();
+  }
+  if ((pid = AddChildProcess(s, m->system->pid)) == -1) {
+    FreeMachine(m2);
+    return -1;
+  }
+  m2->tid = pid;
+  ResetTlb(m2);
+  Put64(m2->ax, 0);
+  if (stack) Put64(m2->sp, stack);
+  if ((flags & (CLONE_CHILD_SETTID_LINUX | CLONE_CHILD_CLEARTID_LINUX)) &&
+      !(ctid & (sizeof(i32) - 1)) &&
+      (ctid_ptr = (_Atomic(i32) *)LookupAddress(m2, ctid))) {
+    if (flags & CLONE_CHILD_SETTID_LINUX) {
+      atomic_store_explicit(ctid_ptr, Little32(pid), memory_order_release);
+    }
+    if (flags & CLONE_CHILD_CLEARTID_LINUX) {
+      m2->ctid = ctid;
+    }
+  }
+  sigfillset(&ss);
+  unassert(!pthread_sigmask(SIG_SETMASK, &ss, &oldss));
+  m2->spawn_sigmask = oldss;
+  err = pthread_create(&thread, 0, OnSpawn, m2);
+  unassert(!pthread_sigmask(SIG_SETMASK, &oldss, 0));
+  if (err) {
+    RemoveChildProcess(pid);
+    FreeMachine(m2);
+    return eagain();
+  }
+  SetChildThread(pid, thread);
+  return pid;
+}
+#endif
+
 #ifdef HAVE_THREADS
 static int SysSpawn(struct Machine *m, u64 flags, u64 stack, u64 ptid, u64 ctid,
                     u64 tls, u64 func) {
@@ -607,6 +721,8 @@ static int SysClone(struct Machine *m, u64 flags, u64 stack, u64 ptid, u64 ctid,
   if (IsForkOrVfork(flags)) {
 #ifdef HAVE_FORK
     return Fork(m, flags, stack, ctid);
+#elif defined(HAVE_THREADED_FORK)
