+#ifdef HAVE_THREADED_FORK
+// Pipes for threaded fork()
+//
+// Guest processes share the host's fds then, and emscripten pipes stop
+// reporting eof reliably, so pipes are implemented here instead. Each
+// is a ring buffer, plus how many fds are open on either end. The host
+// side of a pipe fd is a handle: kPipeHandle | slot << 1 | write end.
+
+#define kPipeSize 65536
+#define kMaxPipes 256
+
+struct Pipe {
+  bool used;
+  int readers;
+  int writers;
+  size_t head;
+  size_t len;
+  u8 *buf;
+  pthread_cond_t_ cond;
+};
+
+static struct Pipes {
+  pthread_mutex_t_ lock;
+  struct Pipe p[kMaxPipes];
+} g_pipes = {
+    PTHREAD_MUTEX_INITIALIZER_,
+};
+
+static struct Pipe *GetPipe(int handle) {
+  return g_pipes.p + ((handle & ~kPipeHandle) >> 1);
+}
+
+static int OpenPipe(int handles[2]) {
+  int i;
+  u8 *buf;
+  struct Pipe *p;
+  if (!(buf = (u8 *)malloc(kPipeSize))) return enomem();
+  LOCK(&g_pipes.lock);
+  for (i = 0; i < kMaxPipes && g_pipes.p[i].used; ++i) {
+  }
+  if (i == kMaxPipes) {
+    UNLOCK(&g_pipes.lock);
+    free(buf);
+    return enfile();
+  }
+  p = g_pipes.p + i;
+  p->used = true;
+  p->readers = 1;
+  p->writers = 1;
+  p->head = 0;
+  p->len = 0;
+  p->buf = buf;
+  unassert(!pthread_cond_init(&p->cond, 0));
+  UNLOCK(&g_pipes.lock);
+  handles[0] = kPipeHandle | i << 1;
+  handles[1] = kPipeHandle | i << 1 | 1;
+  return 0;
+}
+
+int DupPipe(int handle) {
+  LOCK(&g_pipes.lock);
+  if (handle & 1) {
+    ++GetPipe(handle)->writers;
+  } else {
+    ++GetPipe(handle)->readers;
+  }
+  UNLOCK(&g_pipes.lock);
+  return handle;
+}
+
+static int ClosePipe(int handle) {
+  struct Pipe *p = GetPipe(handle);
+  LOCK(&g_pipes.lock);
+  if (handle & 1) {
+    --p->writers;
+  } else {
+    --p->readers;
+  }
+  if (p->readers || p->writers) {
+    unassert(!pthread_cond_broadcast(&p->cond));
+  } else {
+    free(p->buf);
+    unassert(!pthread_cond_destroy(&p->cond));
+    p->used = false;
+  }
+  UNLOCK(&g_pipes.lock);
+  return 0;
+}
+
+// blocks until there's data, or returns 0 once every writer is closed
+static ssize_t ReadPipe(int handle, const struct iovec *iov, int iovcnt) {
+  int i;
+  size_t n, off, got = 0;
+  struct Pipe *p = GetPipe(handle);
+  LOCK(&g_pipes.lock);
+  while (!p->len && p->writers) {
+    unassert(!pthread_cond_wait(&p->cond, &g_pipes.lock));
+  }
+  for (i = 0; i < iovcnt && p->len; ++i) {
+    for (off = 0; off < iov[i].iov_len && p->len; off += n) {
+      n = MIN(MIN(p->len, kPipeSize - p->head), iov[i].iov_len - off);
+      memcpy((u8 *)iov[i].iov_base + off, p->buf + p->head, n);
+      p->head = (p->head + n) % kPipeSize;
+      p->len -= n;
+      got += n;
+    }
+  }
+  unassert(!pthread_cond_broadcast(&p->cond));
+  UNLOCK(&g_pipes.lock);
+  return got;
+}
+
+// blocks until everything is written, or fails with EPIPE once every
+// reader is closed, in which case a partial write is reported as such
+static ssize_t WritePipe(int handle, const struct iovec *iov, int iovcnt) {
+  int i;
+  size_t n, off, tail, put = 0;
+  struct Pipe *p = GetPipe(handle);
+  LOCK(&g_pipes.lock);
+  for (i = 0; i < iovcnt; ++i) {
+    for (off = 0; off < iov[i].iov_len; off += n) {
+      while (p->len == kPipeSize && p->readers) {
+        unassert(!pthread_cond_wait(&p->cond, &g_pipes.lock));
+      }
+      if (!p->readers) {
+        UNLOCK(&g_pipes.lock);
+        return put ? put : epipe();
+      }
+      tail = (p->head + p->len) % kPipeSize;
+      n = MIN(MIN(kPipeSize - p->len, kPipeSize - tail), iov[i].iov_len - off);
+      memcpy(p->buf + tail, (const u8 *)iov[i].iov_base + off, n);
+      p->len += n;
+      put += n;
+      unassert(!pthread_cond_broadcast(&p->cond));
+    }
+  }
+  UNLOCK(&g_pipes.lock);
+  return put;
+}
+
+static int PollPipe(struct pollfd *fds, nfds_t nfds, int timeout) {
+  int ev = 0;
+  struct Pipe *p = GetPipe(fds[0].fd);
+  unassert(nfds == 1);
+  LOCK(&g_pipes.lock);
+  if (fds[0].fd & 1) {
+    if (!p->readers) ev |= POLLERR;
+    if (p->len < kPipeSize) ev |= POLLOUT;
+  } else {
+    if (p->len) ev |= POLLIN;
+    if (!p->writers) ev |= POLLHUP;
+  }
+  UNLOCK(&g_pipes.lock);
+  fds[0].revents = ev & (fds[0].events | POLLERR | POLLHUP);
+  return !!fds[0].revents;
+}
+
+static int TcgetattrPipe(int fd, struct termios *tio) {
+  return enotty();
+}
+
+static int TcsetattrPipe(int fd, int act, const struct termios *tio) {
+  return enotty();
+}
+
+static int TcgetwinsizePipe(int fd, struct winsize *ws) {
+  return enotty();
+}
+
+static int TcsetwinsizePipe(int fd, const struct winsize *ws) {
+  return enotty();
+}
+
+const struct FdCb kFdCbPipe = {
+    .close = ClosePipe,
+    .readv = ReadPipe,
+    .writev = WritePipe,
+    .poll = PollPipe,
+    .tcgetattr = TcgetattrPipe,
+    .tcsetattr = TcsetattrPipe,
+    .tcgetwinsize = TcgetwinsizePipe,
+    .tcsetwinsize = TcsetwinsizePipe,
+};
+
+static int ThreadedPipe2(struct Machine *m, i64 pipefds_addr, i32 flags) {
+  int oflags, handles[2];
+  struct Fd *fd;
+  u8 fds_linux[2][4];
+  if (OpenPipe(handles) == -1) return -1;
+  oflags = (flags & O_CLOEXEC_LINUX ? O_CLOEXEC : 0) |
+           (flags & O_NDELAY_LINUX ? O_NDELAY : 0);
+  LOCK(&m->system->fds.lock);
+  unassert(fd = AddFd(&m->system->fds, handles[0], O_RDONLY | oflags));
+  fd->cb = &kFdCbPipe;
+  Write32(fds_linux[0], fd->fildes);
+  unassert(fd = AddFd(&m->system->fds, handles[1], O_WRONLY | oflags));
+  fd->cb = &kFdCbPipe;
+  Write32(fds_linux[1], fd->fildes);
+  UNLOCK(&m->system->fds.lock);
+  unassert(!CopyToUserWrite(m, pipefds_addr, fds_linux, sizeof(fds_linux)));
+  return 0;
+}
+#endif /* HAVE_THREADED_FORK */
