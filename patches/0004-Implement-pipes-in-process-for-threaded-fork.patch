   int rc;
   int lim;
@@ -51,6 +258,9 @@ int SysPipe2(struct Machine *m, i64 pipefds_addr, i32 flags) {
   if (!IsValidMemory(m, pipefds_addr, sizeof(fds_linux), PROT_WRITE)) {
     return efault();
   }
+#ifdef HAVE_THREADED_FORK
+  return ThreadedPipe2(m, pipefds_addr, flags);
+#endif
   if (!(lim = GetFileDescriptorLimit(m->system))) return emfile();
 #ifdef HAVE_PIPE2
   if ((rc = VfsPipe2(fds, (oflags = XlatOpenFlags(flags)))) != -1) {
