+  struct Proc *p;
+  int self = m->system->pid;
+  if (pgid < 0) return einval();
+  LOCK(&g_procs.lock);
+  if (!(p = FindProc(pid ? pid : self))) {
+    rc = esrch();
+  } else if (p->pid != self && p->ppid != self) {
+    rc = esrch();
+  } else {
+    p->pgid = pgid ? pgid : p->pid;
+    rc = 0;
+  }
+  UNLOCK(&g_procs.lock);
+  return rc;
+}
+
+int GetForegroundGroup(void) {
+  int pgid;
+  LOCK(&g_procs.lock);
+  pgid = g_procs.fgpgid;
+  UNLOCK(&g_procs.lock);
+  return pgid;
+}
+
+void SetForegroundGroup(int pgid) {
+  LOCK(&g_procs.lock);
+  g_procs.fgpgid = pgid;
+  UNLOCK(&g_procs.lock);
+}
+
+void SetTtyIsig(bool isig) {
+  g_procs.isig = isig;
+}
+
+#ifdef __EMSCRIPTEN__
+// The terminal is drawn by the page, so it's the page that reads ^C ^Z
+// and ^\. It asks blink_tty_isig() whether the terminal is in cooked
+// mode, and if so calls blink_tty_signal() with the guest signal, which
+// goes to the foreground process group, rather than passing the byte.
+
+EMSCRIPTEN_KEEPALIVE int blink_tty_isig(void) {
+  return g_procs.isig;
+}
+
+EMSCRIPTEN_KEEPALIVE void blink_tty_signal(int sig) {
+  struct Proc *p;
+  if (!(1 <= sig && sig <= 64)) return;
+  LOCK(&g_procs.lock);
+  for (p = g_procs.list; p; p = p->next) {
+    if (p->pgid == g_procs.fgpgid) Signal(p, sig);
+  }
+  UNLOCK(&g_procs.lock);
+}
+#endif /* __EMSCRIPTEN__ */
+
