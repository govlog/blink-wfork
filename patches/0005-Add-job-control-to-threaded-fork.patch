+// suspends the process `m` belongs to until it gets SIGCONT or SIGKILL
+void StopProcess(struct Machine *m, int sig) {
+  struct Proc *p;
+  LOCK(&g_procs.lock);
+  if ((p = FindProc(m->system->pid)) && p->ppid) {
+    p->stopped = true;
+    p->changed = true;
