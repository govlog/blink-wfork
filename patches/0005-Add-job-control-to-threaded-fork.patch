+// returns true if kill(pid) from process `self` reaches process `p`
+static bool IsKillTarget(struct Proc *p, int pid, int self) {
+  if (pid > 0) return p->pid == pid;
+  if (pid == -1) return p->pid != self && p->ppid;
+  return p->pgid == -pid;
+}
+
+int KillProcess(struct Machine *m, int pid, int sig) {
+  bool any;
+  struct Proc *p;
+  int self = m->system->pid;
+  if (!(0 <= sig && sig <= 64)) return einval();
+  LOCK(&g_procs.lock);
+  if (!pid) pid = -GetPgid(self);
+  for (any = false, p = g_procs.list; p; p = p->next) {
+    if (IsKillTarget(p, pid, self)) {
+      any = true;
+      if (sig) Signal(p, sig);
+    }
+  }
+  UNLOCK(&g_procs.lock);
+  return any ? 0 : esrch();
+}
+
+int GetParentProcess(struct Machine *m) {
+  int ppid;
+  struct Proc *p;
+  LOCK(&g_procs.lock);
+  ppid = (p = FindProc(m->system->pid)) ? p->ppid : 0;
+  UNLOCK(&g_procs.lock);
+  return ppid;
+}
+
+int GetProcessGroup(struct Machine *m, int pid) {
+  int rc;
+  struct Proc *p;
+  LOCK(&g_procs.lock);
+  rc = (p = FindProc(pid ? pid : m->system->pid)) ? p->pgid : esrch();
+  UNLOCK(&g_procs.lock);
+  return rc;
+}
+
+int SetProcessGroup(struct Machine *m, int pid, int pgid) {
