+static void GetProcInfo(struct ProcInfo *pi, struct Proc *p, i64 now) {
+  pi->pid = p->pid;
+  pi->ppid = p->ppid;
+  pi->pgid = p->pgid;
+  if (p->zombie) {
+    pi->state = 'Z';
+  } else if (p->stopped) {
+    pi->state = 'T';
+  } else if (p->m && (!p->m->insyscall || p->m == g_machine)) {
+    pi->state = 'R';  // which includes the process reading /proc now
+  } else {
+    pi->state = 'S';
+  }
+  memcpy(pi->comm, p->comm, sizeof(pi->comm));
+  memcpy(pi->cmdline, p->cmdline, (pi->cmdlen = p->cmdlen));
+  pi->cpu = GetCpuTime(p, now);
+  pi->start = p->start;
