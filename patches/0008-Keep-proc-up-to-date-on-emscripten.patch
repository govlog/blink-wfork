+
+// guest processes run on as many threads as the host has cpus, so the
+// time is shared out between those, which programs read as cores. htop
+// counts them in /sys, rather than in /proc/stat
+static void PublishCpus(void) {
+  int i;
+  char path[64];
+  mkdir("/sys", 0755);
+  mkdir("/sys/devices", 0755);
+  mkdir("/sys/devices/system", 0755);
+  mkdir("/sys/devices/system/cpu", 0755);
+  for (i = 0; i < GetCpuCount(); ++i) {
+    snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d", i);
+    mkdir(path, 0755);
+  }
+}
+
+// rewrites /proc when a program opens it, unless it was rewritten less
+// than 200ms ago, and the same processes are running the same programs
+void RefreshProcs(void) {
+  FILE *f;
+  int i, n, ncpu, running;
+  struct Proc *p;
+  struct ProcInfo *pi;
+  static const int kLoadMinutes[3] = {1, 5, 15};
+  i64 now, busy, uptime, idle, prev;
+  LOCK(&g_publish);
+  LOCK(&g_procs.lock);
+  now = GetNanos();
+  prev = MAX(g_stats.last, g_procs.boot);
+  for (n = 0, p = g_procs.list; p; p = p->next) ++n;
+  if ((!g_procs.fresh && now - prev < 200000000) ||
+      !(pi = (struct ProcInfo *)malloc(n * sizeof(*pi)))) {
+    UNLOCK(&g_procs.lock);
+    UNLOCK(&g_publish);
+    return;
+  }
+  for (busy = g_procs.dead, i = 0, p = g_procs.list; p; p = p->next, ++i) {
+    GetProcInfo(pi + i, p, now);
+    busy += pi[i].cpu;
+  }
+  uptime = now - g_procs.boot;
+  g_procs.fresh = false;
+  g_stats.last = now;
+  UNLOCK(&g_procs.lock);
+  for (running = i = 0; i < n; ++i) {
+    WriteProcFiles(pi + i);
+    running += pi[i].state == 'R';
+  }
+  free(pi);
+  for (i = 0; i < 3; ++i) {  // decays like the kernel's
+    g_stats.load[i] += (running - g_stats.load[i]) *
+                       (1 - exp(-(now - prev) / 1e9 / (60 * kLoadMinutes[i])));
+  }
+  g_stats.uptime = uptime;
+  g_stats.procs = n;
+  ncpu = GetCpuCount();  // see PublishCpus()
+  idle = MAX(0, ncpu * uptime - busy);
+  if ((f = fopen("/proc/stat", "w"))) {
+    fprintf(f, "cpu  %lld 0 0 %lld 0 0 0 0 0 0\n", (long long)(busy / 10000000),
+            (long long)(idle / 10000000));
+    for (i = 0; i < ncpu; ++i) {
+      fprintf(f, "cpu%d %lld 0 0 %lld 0 0 0 0 0 0\n", i,
+              (long long)(busy / ncpu / 10000000),
+              (long long)(idle / ncpu / 10000000));
+    }
+    fprintf(f, "btime %lld\nprocesses %d\nprocs_running %d\nprocs_blocked 0\n",
+            (long long)(time(0) - uptime / 1000000000), g_procs.lastpid,
+            running);
+    fclose(f);
+  }
+  PrintProcFile("/proc/uptime", "%.2f %.2f\n", uptime / 1e9, idle / 1e9);
+  PrintProcFile("/proc/loadavg", "%.2f %.2f %.2f %d/%d %d\n", g_stats.load[0],
+                g_stats.load[1], g_stats.load[2], running, n, g_procs.lastpid);
+  PrintProcFile("/proc/meminfo",
+                "MemTotal:       %8zu kB\nMemFree:        %8zu kB\n"
+                "MemAvailable:   %8zu kB\nBuffers:               0 kB\n"
+                "Cached:                0 kB\nSwapCached:            0 kB\n"
+                "SwapTotal:             0 kB\nSwapFree:              0 kB\n"
+                "Shmem:                 0 kB\nSReclaimable:          0 kB\n",
+                emscripten_get_heap_max() / 1024, GetFreeMemory() / 1024,
+                GetFreeMemory() / 1024);
+  UNLOCK(&g_publish);
+}
+
+// tells sysinfo() the same as /proc, since busybox and btop ask it for
+// the uptime and load, rather than the browser's
+void GetSysinfo(struct sysinfo_linux *si) {
+  int i;
+  RefreshProcs();
+  memset(si, 0, sizeof(*si));
+  LOCK(&g_publish);
+  Write64(si->uptime, g_stats.uptime / 1000000000);
+  for (i = 0; i < 3; ++i) {
+    Write64(si->loads[i], g_stats.load[i] * 65536);  // SI_LOAD_SHIFT
+  }
+  Write16(si->procs, g_stats.procs);
+  UNLOCK(&g_publish);
+  Write64(si->totalram, emscripten_get_heap_max());
+  Write64(si->freeram, GetFreeMemory());
+  Write32(si->mem_unit, 1);
 }
 #else
