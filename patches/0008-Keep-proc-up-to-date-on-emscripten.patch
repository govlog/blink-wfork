+// frees a zombie that was taken out of the table
+static void FreeProc(struct Proc *p) {
+  // the thread may still be unwinding after it marked itself a zombie
+  unassert(!pthread_join(p->thread, 0));
+  LOCK(&g_procs.lock);
+  g_procs.dead += p->m->runtime;
+  UNLOCK(&g_procs.lock);
+  UnpublishProc(p->pid);
+  FreeMachine(p->m);
+  free(p);
+}
