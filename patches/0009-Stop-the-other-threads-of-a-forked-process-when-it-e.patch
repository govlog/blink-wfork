 struct Proc {
   struct Proc *next;
@@ -76,8 +75,9 @@ struct Proc {
   int cmdlen;
   char cmdline[256];  // the NUL-separated argv of the program it runs
   i64 start;          // nanoseconds since boot when it was forked
+  i64 runtime;        // cpu time of its threads which are gone
   pthread_t thread;
-  struct Machine *m;  // changes on execve()
+  struct Machine *m;  // one of its threads, which changes on execve()
 };
 
 static struct Procs {
@@ -107,6 +107,21 @@ static i64 GetNanos(void) {
   return ToNanoseconds(GetMonotonic());
 }
 
+// returns the cpu time used by thread `m`, as OpSyscall() tracks it
+static i64 GetThreadTime(struct Machine *m, i64 now, bool stopped) {
+  return m->runtime + (m->insyscall || stopped ? 0 : now - m->runsince);
+}
+
+// waits for a process to change, or for a moment, since that's how the
+// threads KillOtherThreads() wants gone notice, without host signals
+static void WaitProcs(void) {
+  int rc;
+  struct timespec deadline;
+  deadline = AddTime(GetTime(), FromMilliseconds(kPollingMs));
+  rc = pthread_cond_timedwait(&g_procs.cond, &g_procs.lock, &deadline);
+  unassert(rc == 0 || rc == ETIMEDOUT);
+}
+
 #ifdef __EMSCRIPTEN__
 // Emscripten builds have no procfs, so blink writes /proc itself, when
 // a program opens something under /proc, so ps, top and htop see the
@@ -157,11 +172,21 @@ static void PrintProcFile(const char *path, const char *fmt, ...) {
   }
 }
 
-// returns cpu time used by `p`, whose machine is updated by OpSyscall()
+// returns the cpu time used by all the threads of process `p`
 static i64 GetCpuTime(struct Proc *p, i64 now) {
-  struct Machine *m;
-  if (!(m = p->m)) return 0;
-  return m->runtime + (m->insyscall || p->stopped ? 0 : now - m->runsince);
+  i64 res;
+  struct Dll *e;
+  struct System *s;
+  res = p->runtime;
+  if (!p->zombie && p->m) {
+    s = p->m->system;
+    LOCK(&s->machines_lock);
+    for (e = dll_first(s->machines); e; e = dll_next(s->machines, e)) {
+      res += GetThreadTime(MACHINE_CONTAINER(e), now, p->stopped);
+    }
+    UNLOCK(&s->machines_lock);
+  }
+  return res;
 }
 
 static void GetProcInfo(struct ProcInfo *pi, struct Proc *p, i64 now) {
@@ -410,7 +435,7 @@ static void FreeProc(struct Proc *p) {
   // the thread may still be unwinding after it marked itself a zombie
   unassert(!pthread_join(p->thread, 0));
   LOCK(&g_procs.lock);
-  g_procs.dead += p->m->runtime;
+  g_procs.dead += p->runtime;
   UNLOCK(&g_procs.lock);
   UnpublishProc(p->pid);
   FreeMachine(p->m);
@@ -449,13 +474,12 @@ void AddMainProcess(struct Machine *m) {
   unassert((p = (struct Proc *)calloc(1, sizeof(*p))));
   p->pid = p->pgid = m->system->pid;
   p->m = m;
-  m->runsince = GetNanos();
   LOCK(&g_procs.lock);
   p->next = g_procs.list;
   g_procs.list = p;
   g_procs.lastpid = MAX(g_procs.lastpid, p->pid);
   g_procs.fgpgid = p->pgid;
-  g_procs.boot = m->runsince;
+  g_procs.boot = GetNanos();
   UNLOCK(&g_procs.lock);
   PublishCpus();
 }
@@ -505,13 +529,46 @@ void SetProcessMachine(int pid, struct Machine *m) {
     if (p->m && (m->signals |= p->m->signals)) {
       atomic_store_explicit(&m->attention, true, memory_order_release);
     }
-    if (p->m) m->runtime = p->m->runtime;  // cpu time survives execve() too
-    m->runsince = GetNanos();
     p->m = m;
   }
   UNLOCK(&g_procs.lock);
 }
 
+// called by FreeMachine() before thread `m` leaves its process, whose
+// cpu time it adds to, and which lives on in one of its other threads
+void RemoveThread(struct Machine *m) {
+  struct Dll *e;
+  struct Proc *p;
+  struct Machine *m2;
+  struct System *s = m->system;
+  LOCK(&g_procs.lock);
+  if ((p = FindProc(s->pid)) && !p->zombie) {
+    p->runtime += GetThreadTime(m, GetNanos(), p->stopped);
+    m->runtime = 0;
+    m->killed = true;  // so it won't be picked below by another thread
+    if (p->m == m) {
+      p->m = 0;
+      LOCK(&s->machines_lock);
+      for (e = dll_first(s->machines); e; e = dll_next(s->machines, e)) {
+        if (!(m2 = MACHINE_CONTAINER(e))->killed) {
+          p->m = m2;
+          break;
+        }
+      }
+      UNLOCK(&s->machines_lock);
+    }
+  }
+  UNLOCK(&g_procs.lock);
+}
+
+// returns true if thread `m` must stop waiting, since it has a signal
+// to handle, or KillOtherThreads() wants it gone: no host signal will
+// interrupt its wait, since other processes are other threads here
+bool IsInterrupted(struct Machine *m) {
+  return atomic_load_explicit(&m->killed, memory_order_acquire) ||
+         (m->signals & ~m->sigmask);
+}
+
 void SetChildThread(int pid, pthread_t thread) {
   struct Proc *p;
   LOCK(&g_procs.lock);
@@ -540,6 +597,7 @@ _Noreturn void ExitChildProcess(struct Machine *m, int wstatus) {
   UNLOCK(&m->system->fds.lock);
   LOCK(&g_procs.lock);
   if ((p = FindProc(m->system->pid))) {
+    p->runtime += GetThreadTime(m, GetNanos(), p->stopped);
     p->m = m;
     p->wstatus = wstatus;
     p->zombie = true;
@@ -559,8 +617,8 @@ void StopProcess(struct Machine *m, int sig) {
     p->changed = true;
     p->wstatus = sig << 8 | 0x7f;  // WIFSTOPPED
     NotifyParent(p);
-    while (p->stopped) {
-      unassert(!pthread_cond_wait(&g_procs.cond, &g_procs.lock));
+    while (p->stopped && !m->killed) {
+      WaitProcs();
     }
   }
   UNLOCK(&g_procs.lock);
@@ -599,8 +657,8 @@ int WaitChildProcess(struct Machine *m, int pid, i64 wstatusaddr, int options,
         break;
       }
     }
-    if (p || !any || (options & WNOHANG)) break;
-    unassert(!pthread_cond_wait(&g_procs.cond, &g_procs.lock));
+    if (p || !any || (options & WNOHANG) || m->killed) break;
+    WaitProcs();
   }
   if (p) {
     rc = p->pid;
@@ -608,7 +666,7 @@ int WaitChildProcess(struct Machine *m, int pid, i64 wstatusaddr, int options,
     reap = p->zombie;
   }
   UNLOCK(&g_procs.lock);
-  if (!p) return any ? 0 : echild();
+  if (!p) return !any ? echild() : m->killed ? eintr() : 0;
   if (reap) FreeProc(p);
   if (wstatusaddr) {
     Write32(gwstatus, ws);
